# Copy to .env and fill in. Never commit .env.
GLM_API_KEY=
MAJLIS_BACKEND=glm            # glm | mock (offline, no key)
MAJLIS_MODEL=glm-5.3          # demo runs; glm-5.3-flash for cheap runs
MAJLIS_GLM_BASE_URL=https://api.z.ai/api/paas/v4
MAJLIS_EFFORT=low             # low | high | max (GLM reasoning_effort)
